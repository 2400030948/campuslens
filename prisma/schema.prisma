generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model College {
  id              String     @id
  slug            String     @unique
  name            String
  shortName       String
  city            String
  state           String
  type            String
  established     Int
  rating          Float
  totalReviews    Int        @default(0)
  annualFees      Int
  acceptanceRate  Float
  studentCount    Int
  facultyRatio    String
  campusSizeAcres Int
  description     String
  longDescription String
  tags            String[]
  accentIndex     Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  courses         Course[]
  placement       Placement?
  reviews         Review[]

  @@index([city])
  @@index([state])
  @@index([rating])
  @@index([annualFees])
  @@index([name])
}

model Course {
  id            String  @id
  collegeId     String
  name          String
  degree        String
  durationYears Int
  annualFees    Int
  seats         Int
  college       College @relation(fields: [collegeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([collegeId])
  @@index([name])
}

model Placement {
  id             String  @id
  collegeId      String  @unique
  averagePackage Float
  highestPackage Float
  medianPackage  Float
  placementRate  Float
  college        College @relation(fields: [collegeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model Review {
  id        String   @id
  collegeId String
  author    String
  course    String
  rating    Int
  date      DateTime
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([collegeId])
  @@index([rating])
}
